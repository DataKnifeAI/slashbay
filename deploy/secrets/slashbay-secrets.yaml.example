# Example only — do not commit a filled copy.
# Create the live secret with kubectl (see secrets/README.md).
apiVersion: v1
kind: Secret
metadata:
  name: slashbay-secrets
  namespace: slashbay
  labels:
    app: slashbay
    app.kubernetes.io/name: slashbay
type: Opaque
stringData:
  OPENAI_API_KEY: ""
  CURSOR_API_KEY: ""
  CODER_TOKEN: ""
  GITHUB_WEBHOOK_SECRET: ""
  GITHUB_TOKEN: ""
  GITLAB_WEBHOOK_TOKEN: ""
  GITLAB_TOKEN: ""
