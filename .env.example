# Slashbay local / deploy configuration. Copy to .env — never commit secrets.

# --- HTTP ---
SLASHBAY_HOST=0.0.0.0
SLASHBAY_PORT=8080
# Public URL warm dkai-agent pullers use (injected into those workspaces).
SLASHBAY_URL=http://127.0.0.1:8080
# Dry-run: triage + state + log comments; do not call issue APIs.
SLASHBAY_DRY_RUN=true

# --- State (issue ↔ run ↔ job) ---
# memory://  or  sqlite:///./slashbay.db
# SQLite is fine while the API Deployment replicas=1 (claim is in-process + DB).
SLASHBAY_STATE_DSN=sqlite:///./slashbay.db

# Pool secret for GET /v1/jobs/claim and progress/complete. Same token on every
# warm workspace. Not a Cursor account.
SLASHBAY_WORKER_TOKEN=
# If a claimed job sends no progress for this long, it returns to queued.
SLASHBAY_JOB_LEASE_SECONDS=900

# --- Allowlist (comma-separated owner/name or owner/*) ---
SLASHBAY_REPO_ALLOWLIST=DataKnifeAI/*

# Process these issue actions. Optional label gate: if set, the issue must have it.
SLASHBAY_TRIGGER_EVENTS=opened,reopened
SLASHBAY_TRIGGER_LABEL=

# Expected warm puller count (2–5). Queue still accepts work if deeper.
SLASHBAY_MAX_CONCURRENT=3

# --- OpenAI triage (classifier only; not the coding worker) ---
OPENAI_API_KEY=
SLASHBAY_TRIAGE_MODEL=gpt-5-nano
SLASHBAY_TRIAGE_ESCALATE_MODEL=gpt-5.6-luna
# Escalate to luna when nano confidence is below this (calibrate toward ~10%).
SLASHBAY_TRIAGE_ESCALATE_BELOW=0.7

# --- Cursor CLI inside warm dkai-agent workspaces (not injected by Slashbay) ---
# One paid human seat. Suggested key name: dataknife-coder-issue-bot
# Set cursor_api_key on the workspace. Do not share one Pro key across a farm.
CURSOR_API_KEY=

# Optional override for the git URL the puller clones.
# Empty = use the issue repository clone URL.
SLASHBAY_WORKSPACE_GIT_URL=

# --- Coder (optional list/health of warm workspaces; Slashbay does not berth) ---
CODER_ACCESS_URL=https://coder.example.com
CODER_TOKEN=
CODER_TEMPLATE=dkai-agent
# Optional org/user for workspace list. Empty = authenticated token user.
CODER_ORGANIZATION=
CODER_WORKSPACE_OWNER=me

# --- GitHub webhooks + comments ---
GITHUB_WEBHOOK_SECRET=
# PAT or GitHub App installation token for comments/labels (not the webhook secret).
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

# --- GitLab webhooks + notes ---
GITLAB_WEBHOOK_TOKEN=
GITLAB_TOKEN=
GITLAB_API_URL=https://gitlab.com/api/v4
